HOST=127.0.0.1
GATEWAY_PORT=8080
INGEST_PORT=8081
VIEWER_PORT=8082
JANITOR_PORT=8083

WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_ORIGIN=http://localhost:5173

PUBLIC_INGEST_URL=http://localhost:8081

# at least 32 characters
MAINTENANCE_TOKEN=

# origins allowed to call the gateway and ingest from a browser, comma separated.
# empty allows none
CORS_ALLOWED_ORIGINS=http://localhost:5173

# proxies whose cf-connecting-ip header is trusted, comma separated addresses or
# cidr ranges. use the ranges at https://www.cloudflare.com/ips/ when deployed
# behind Cloudflare. empty trusts no header and keys limits by the socket peer
TRUSTED_PROXY_CIDRS=

DATABASE_URL=postgres://iono:iono@localhost:5432/iono
DATABASE_MAX_CONNECTIONS=10

S3_BUCKET=iono-uploads
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# at least 32 characters
JWT_SECRET=
JWT_ACCESS_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

FILE_ENCRYPTION_KEY=

AUTH_RATE_LIMIT_SECONDS_PER_REQUEST=2
AUTH_RATE_LIMIT_BURST=5
INGEST_RATE_LIMIT_SECONDS_PER_REQUEST=1
INGEST_RATE_LIMIT_BURST=30

FILE_ENCRYPTION_KEY_VERSION=1
FILE_ENCRYPTION_PREVIOUS_KEYS=

# account + ceremony policy
RECOVERY_WINDOW_DAYS=30
TOTP_RECOVERY_CODE_COUNT=10
OAUTH_FLOW_STATE_TTL_MINUTES=15
WEBAUTHN_CEREMONY_TTL_MINUTES=5

# paste size limit
MAX_PASTE_SIZE_KB=1024

# janitor rows per pass, bounds db and s3 load
SWEEP_BATCH_SIZE=500
ENCRYPT_BACKFILL_BATCH_SIZE=100
ENCRYPT_BACKFILL_MAX_OBJECT_MB=512

# browsers get a short ttl so edits show quickly, the edge a long one we purge
BROWSER_CACHE_MAX_AGE_SECONDS=300
EDGE_CACHE_MAX_AGE_SECONDS=31536000

MAX_UPLOAD_SIZE_MB=10240

CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=

STRIPE_API_KEY=
STRIPE_PORTAL_RETURN_URL=

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:8080/auth/discord/callback
DISCORD_SUCCESS_REDIRECT_URL=http://localhost:5173/auth/complete
