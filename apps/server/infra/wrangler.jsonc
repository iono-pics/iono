{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "iono-server",
	"main": "src/index.ts",
	"compatibility_date": "2026-07-09",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
    	"enabled": true,
  	},
	// one image, three pools. *_INSTANCES below must stay within max_instances
	"containers": [
		{
			"class_name": "ServerContainer",
			"image": "../Dockerfile",
			"instance_type": "basic",
			"max_instances": 4
		},
		{
			"class_name": "IngestContainer",
			"image": "../Dockerfile",
			"instance_type": "basic",
			"max_instances": 6
		},
		{
			"class_name": "ViewerContainer",
			"image": "../Dockerfile",
			"instance_type": "basic",
			"max_instances": 8
		}
	],
	"vars": {
		"API_HOST": "api.iono.pics",
		"INGEST_HOST": "up.iono.pics",
		"PUBLIC_INGEST_URL": "https://up.iono.pics",
		"STRIPE_PORTAL_RETURN_URL": "https://iono.pics/settings",
		"WEBAUTHN_RP_ID": "iono.pics",
		"WEBAUTHN_RP_ORIGIN": "https://iono.pics",
		"DISCORD_REDIRECT_URI": "https://api.iono.pics/auth/discord/callback",
		"DISCORD_SUCCESS_REDIRECT_URL": "https://iono.pics/auth/complete",
		"RUST_LOG": "info",
		// per process. 9 processes at the instance counts below, keep the
		// total under what the database allows
		"DATABASE_MAX_CONNECTIONS": "5",
		"CORE_INSTANCES": "2",
		"INGEST_INSTANCES": "2",
		"VIEWER_INSTANCES": "3"
	},
	"routes": [
		{ "pattern": "api.iono.pics", "custom_domain": true },
		{ "pattern": "cdn.iono.pics", "custom_domain": true },
		{ "pattern": "up.iono.pics", "custom_domain": true }
	],
	"triggers": {
		"crons": ["0 * * * *"]
	},
	"durable_objects": {
		"bindings": [
			{
				"class_name": "ServerContainer",
				"name": "SERVER_CONTAINER"
			},
			{
				"class_name": "IngestContainer",
				"name": "INGEST_CONTAINER"
			},
			{
				"class_name": "ViewerContainer",
				"name": "VIEWER_CONTAINER"
			}
		]
	},
	"migrations": [
		{
			"new_sqlite_classes": ["ServerContainer"],
			"tag": "v1"
		},
		{
			"new_sqlite_classes": ["IngestContainer", "ViewerContainer"],
			"tag": "v2"
		}
	]
}
